# ==============================================================================
# AIRFARE-X INDIA: Real-Time Airfare Price Intelligence Platform
# Environment Configuration
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Amadeus API Credentials (Leave empty to trigger DEMO_MODE automatically)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# SerpAPI Google Flights (Leave empty to trigger DEMO_MODE automatically)
SERPAPI_KEY=

# Database Configuration
# Production (Vercel): Set DATABASE_URL to your Supabase/PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE
# (postgres:// URLs are automatically normalized to postgresql://)
# Local: Leave blank to use local SQLite (./airfare_x.db)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SUPABASE_URL=
SUPABASE_KEY=

# CORS Settings (Optional comma-separated list of allowed origins)
# Default includes localhost:3000, localhost:5173, localhost:8501, and *.vercel.app
CORS_ORIGINS=

# Security & Compliance
API_SECRET_KEY=mo_spi_diid_airfare_x_super_secret_key_2026
SCRAPER_ENABLED=false
DEFAULT_RATE_LIMIT_SECONDS=5
MAX_RETRIES=3

# Statistical & Index Parameters
INDEX_BASE_DATE=2026-01-01
BASE_INDEX_VALUE=100.0
OUTLIER_METHOD=IQR
OUTLIER_IQR_MULTIPLIER=1.5

# Monitoring
SENTRY_DSN=
